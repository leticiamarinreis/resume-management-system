<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Currículos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <header class="topo no-print">
        <a class="marca" asp-controller="Curriculo" asp-action="Index">Currículos</a>
        <nav class="topo-menu">
            <a asp-controller="Curriculo" asp-action="Index">Listar currículos</a>
            <a asp-controller="Curriculo" asp-action="Create">Novo currículo</a>
        </nav>
    </header>

    <main class="conteudo">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alerta alerta-ok no-print" role="status">@mensagem</div>
        }
        @RenderBody()
    </main>
</body>
</html>
